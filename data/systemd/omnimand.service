[Unit]
Description=Omniman daemon (indexing, clipboard, hotkey)
Documentation=https://github.com/adrien/omniman
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/omnimand
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=omnimand=info
# The daemon registers as org.adrien.OmnimanDaemon on the session bus.
# The UI (omniman) registers as org.adrien.Omniman (GTK4 app ID).

[Install]
WantedBy=graphical-session.target
